# Αντίγραψε αυτό το αρχείο σε .env και βάλε τα δικά σου tokens.
# Το FOOTBALL_DATA_TOKEN παίρνεται δωρεάν από https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=βάλε_εδώ_το_token_σου

# Προαιρετικό -- ζωντανές αποδόσεις στοιχήματος (στήλη "Αγορά").
# Παίρνεται δωρεάν από https://the-odds-api.com/
ODDS_API_TOKEN=βάλε_εδώ_το_token_σου
